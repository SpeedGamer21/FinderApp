    "version": "0.2.0",
    "configurations": [
        {
            "name": "Duplicate Finder: Debug preview (sample files)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/DuplicateCheck_11.py",
            "args": ["--demo"],
            "console": "integratedTerminal"
        },
        {
            "name": "Duplicate Finder: Real folders",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/DuplicateCheck_11.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}
